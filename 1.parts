# Таблица деталей для 1.k (формат: k_input/k_parts.hpp)
# SOLID_PART <PID> <itype> <rho> [hsml=<h>] [v=<vx> <vy> <vz>]
#
# Шаг сетки в 1.k равен 0.02, поэтому hsml = 2*dx = 0.04 задан явно:
# массы в .k (0.0628 и 0.022) соответствуют ~7850 и ~2750 кг/м3 при этом шаге,
# и без hsml= он был бы выведен из массы и плотности таблицы.

SOLID_PART 1 10 2510 hsml=0.04   # керамика B4C (itype 10, JH-2)
SOLID_PART 2 4  2700 hsml=0.04   # алюминий (itype 4, Ми-Грюнайзен)
