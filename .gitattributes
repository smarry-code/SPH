# Регрессионные эталоны (tests/test_regression.cpp): сгенерированы кодом,
# около мегабайта на файл. -diff: построчный дифф таких файлов нечитаем и
# засоряет вывод git diff; расхождение разбирается отчётом теста.
# -text: без преобразования переводов строк — файл пишется с LF, и
# перегенерация на другой ОС не должна менять его целиком.
tests/data/regression/*.txt -text -diff

# .bat читается cmd.exe: нужны CRLF (tools/cuda_env.bat).
*.bat text eol=crlf
# fp32-эталоны регрессии — как fp64 выше.
tests/data/regression_fp32/*.txt -text -diff

# Эталоны test_time_integration_fiber (fiber/CUDA_PLAN.md, этап Г1) —
# заготовка для сравнения CPU/GPU (Г8), тот же принцип, что у регрессии выше.
tests/data/fiber_time_integration/*.txt -text -diff
tests/data/fiber_time_integration_fp32/*.txt -text -diff
